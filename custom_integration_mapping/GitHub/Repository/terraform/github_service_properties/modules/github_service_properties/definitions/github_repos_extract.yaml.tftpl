---
# Pull every repo in the ${github_org} org. Reads the first page only (100 repos); see the README "Limits".
# Token: fine-grained PAT with the ${github_org} org as resource owner, All repositories, Repository permission "Metadata: Read" (covers private repos and custom_properties).
extractors:
- external_kind: github_repos
  external_id: ".id | tostring"
  iterator: "."
  http_polling:
    method: GET
    url: 'https://api.github.com/orgs/${github_org}/repos?per_page=100&type=all&page={{ cursor | default: ''1'' }}'
    headers:
    - name: Authorization
      value: Bearer {{ '${github_token_secret_alias}' | secret }}
    - name: Accept
      value: application/vnd.github+json
    - name: X-GitHub-Api-Version
      value: '2022-11-28'
